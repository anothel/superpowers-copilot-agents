{
  "name": "superpowers-copilot-agents",
  "displayName": "Superpowers Copilot Agents",
  "description": "Superpowers workflow skills converted to VS Code Copilot agents. Install once, get all agents automatically.",
  "version": "7.0.1",
  "publisher": "anothel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anothel/superpowers-copilot-agents"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "copilot",
    "agent",
    "superpowers",
    "tdd",
    "code-review",
    "debugging",
    "workflow",
    "brainstorm",
    "planning"
  ],
  "contributes": {
    "chatAgents": [
      { "path": "./.github/agents/using-superpowers.agent.md" },
      { "path": "./.github/agents/brainstorming.agent.md" },
      { "path": "./.github/agents/writing-plans.agent.md" },
      { "path": "./.github/agents/executing-plans.agent.md" },
      { "path": "./.github/agents/subagent-driven-development.agent.md" },
      { "path": "./.github/agents/test-driven-development.agent.md" },
      { "path": "./.github/agents/systematic-debugging.agent.md" },
      { "path": "./.github/agents/requesting-code-review.agent.md" },
      { "path": "./.github/agents/receiving-code-review.agent.md" },
      { "path": "./.github/agents/finishing-a-development-branch.agent.md" },
      { "path": "./.github/agents/dispatching-parallel-agents.agent.md" },
      { "path": "./.github/agents/using-git-worktrees.agent.md" },
      { "path": "./.github/agents/verification-before-completion.agent.md" },
      { "path": "./.github/agents/writing-agents.agent.md" },
      { "path": "./.github/agents/diagnosing-superpowers.agent.md" },
      { "path": "./.github/agents/code-reviewer.agent.md" }
    ]
  },
  "scripts": {
    "check": "node scripts/check-agents.cjs",
    "test": "node --test scripts/visual-server.test.cjs",
    "vscode:prepublish": "npm run check",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0",
    "js-yaml": "^4.1.1"
  }
}
