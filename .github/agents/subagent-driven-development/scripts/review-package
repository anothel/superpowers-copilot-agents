#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# Usage: review-package PLAN_FILE BASE HEAD_OR_WORKTREE [OUTFILE]
# WORKTREE includes tracked changes and new files without requiring commits.
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

# Preserve caller-relative paths, then enumerate Git paths from the repo root.
plan="$(cd -- "$(dirname "$plan")" && pwd -P)/$(basename "$plan")"
scripts="$(cd -- "$(dirname "$0")" && pwd -P)"
out=""
if [ $# -eq 4 ]; then
  out="$(cd -- "$(dirname "$4")" && pwd -P)/$(basename "$4")"
fi
root="$(cd -- "$(git rev-parse --show-toplevel)" && pwd -P)"
cd -- "$root"

untracked_files() {
  while IFS= read -r -d '' file; do
    # An unignored output may already exist or appear after redirection opens it.
    [ "$root/$file" = "$out" ] && continue
    [ -n "$out" ] && [ "$root/$file" -ef "$out" ] && continue
    printf '%s\0' "$file"
  done < <(git ls-files --others --exclude-standard -z)
}

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
if [ "$head" = "WORKTREE" ]; then
  has_untracked=0
  while IFS= read -r -d '' file; do has_untracked=1; break; done < <(untracked_files)
  if git diff --quiet "$base" -- && [ "$has_untracked" -eq 0 ]; then
    echo "empty working-tree diff from BASE: $base" >&2
    exit 3
  fi
else
  git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

# Range guards (exit 3): a wrong-branch HEAD yields a range that is empty or
# not rooted at BASE; either would silently produce a bogus review package.
git merge-base --is-ancestor "$base" "$head" || { echo "HEAD is not a descendant of BASE: ${base}..${head}" >&2; exit 3; }
[ "$(git rev-list --count "${base}..${head}")" -gt 0 ] || { echo "empty commit range: ${base}..${head}" >&2; exit 3; }
fi

if [ $# -ne 4 ]; then
  # Invoke via bash rather than direct exec: some extractors (Python zipfile)
  # strip Unix exec bits when unpacking marketplace packages (#2040).
  dir=$("${BASH:-bash}" "$scripts/sdd-workspace" "$plan")
  if [ "$head" = "WORKTREE" ]; then
    out=$(mktemp "$dir/review-$(git rev-parse --short "$base")..WORKTREE-XXXXXX.diff")
  else
    out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
  fi
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  if [ "$head" = "WORKTREE" ]; then
    git log --oneline "${base}..HEAD"
    echo "Working tree includes staged, unstaged, and untracked files."
  else
    git log --oneline "${base}..${head}"
  fi
  echo
  echo "## Files changed"
  if [ "$head" = "WORKTREE" ]; then
    git diff --stat "$base" --
    while IFS= read -r -d '' file; do printf '%s\n' "$file"; done < <(untracked_files)
  else
    git diff --stat "${base}..${head}"
  fi
  echo
  echo "## Diff"
  if [ "$head" = "WORKTREE" ]; then
    git diff -U10 "$base" --
    while IFS= read -r -d '' file; do
      git diff --no-index -U10 -- /dev/null "$file" || [ "$?" -eq 1 ]
    done < <(untracked_files)
  else
    git diff -U10 "${base}..${head}"
  fi
} > "$out"

echo "wrote ${out}: ${base}..${head}, $(wc -c < "$out" | tr -d ' ') bytes"
